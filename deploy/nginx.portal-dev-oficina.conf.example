# Ejemplo para la VM simidev, dentro del contexto http de Nginx.
# Infraestructura debe reemplazar dominio, IP publica de salida de la oficina
# y rutas del certificado antes de instalarlo. No abrir 8005 ni 5178 a Internet.
# La emision/renovacion del certificado debe funcionar sin publicar este sitio
# por HTTP; por ejemplo, mediante validacion DNS controlada por Infraestructura.

server {
    listen 443 ssl;
    server_name portal-dev.example.cl;

    ssl_certificate /etc/letsencrypt/live/portal-dev.example.cl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal-dev.example.cl/privkey.pem;

    # Reforzar tambien en el firewall de Google Cloud: TCP 443 solo desde
    # la IP publica de salida de la oficina. 203.0.113.10 es un ejemplo.
    allow 203.0.113.10;
    deny all;

    root /opt/Portal-Infraestructura-DEV/siminfra-frontend/dist;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # No aceptar una cadena X-Forwarded-For enviada por el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /static/ {
        alias /opt/Portal-Infraestructura-DEV/staticfiles/;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        expires -1;
    }

    # La ficha QR es una ruta de React; tambien debe abrir al cargar la URL.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
