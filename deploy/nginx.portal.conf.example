# Ejemplo para incluir dentro del contexto http de Nginx.
# Reemplazar dominio, rutas y certificados antes de instalarlo.
# El backend Waitress escucha solo en 127.0.0.1:8000.

server {
    listen 80;
    server_name portal.example.cl;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name portal.example.cl;

    ssl_certificate /etc/letsencrypt/live/portal.example.cl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.cl/privkey.pem;

    root /srv/portal/siminfra-frontend/dist;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /static/ {
        alias /srv/portal/staticfiles/;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        expires -1;
    }

    # La ficha QR es una ruta de React, no una ruta de Django.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
