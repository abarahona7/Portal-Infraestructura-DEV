# Copiar como .env en el servidor y reemplazar todos los valores "replace-with".
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=portal.example.cl
DJANGO_TIME_ZONE=America/Santiago
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json
DJANGO_REQUEST_LOG_LEVEL=INFO

# Frontend y API publicados bajo HTTPS
CORS_ALLOWED_ORIGINS=https://portal.example.cl
CSRF_TRUSTED_ORIGINS=https://portal.example.cl
CSRF_COOKIE_SAMESITE=Lax

# MySQL 8
DATABASE_ENGINE=mysql
DATABASE_NAME=siminfra_db
DATABASE_USER=siminfra_user
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_BIND_HOST=127.0.0.1
DATABASE_CONN_MAX_AGE=60
# Ruta del certificado CA cuando el proveedor exige TLS hacia MySQL.
DATABASE_SSL_CA=
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password

# Cifrado de campos sensibles
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
# Utilizar solamente durante una migración ENC:: y retirarla después.
LEGACY_DJANGO_SECRET_KEY=

# JWT y sesión
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE=siminfra_refresh
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_PATH=/api/auth/
PORTAL_IDLE_TIMEOUT_SECONDS=300
PORTAL_PAGE_SIZE=50
PORTAL_MAX_PAGE_SIZE=200
LOGIN_THROTTLE_RATE=5/min
SECRET_REVEAL_THROTTLE_RATE=5/min

# HTTPS. USE_X_FORWARDED_PROTO=True requiere un proxy controlado que reemplace
# X-Forwarded-Proto antes de enviar la solicitud a Django.
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Dirección HTTPS desde la que se abrirán las fichas QR.
PORTAL_PUBLIC_URL=https://portal.example.cl
