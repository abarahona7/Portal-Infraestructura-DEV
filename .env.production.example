# Copiar como .env en el servidor y reemplazar todos los valores "replace-with".
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=portal.example.cl
DJANGO_TIME_ZONE=America/Santiago
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json
DJANGO_REQUEST_LOG_LEVEL=INFO

# Frontend y API publicados bajo HTTPS
CORS_ALLOWED_ORIGINS=https://portal.example.cl
CSRF_TRUSTED_ORIGINS=https://portal.example.cl
CSRF_COOKIE_SAMESITE=Lax

# MySQL 8.4 LTS
DATABASE_ENGINE=mysql
DATABASE_NAME=siminfra_db
DATABASE_USER=siminfra_user
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_BIND_HOST=127.0.0.1
DATABASE_CONN_MAX_AGE=60
# Obligatorio cuando DATABASE_HOST no es localhost. Debe validar la CA del servidor MySQL.
DATABASE_SSL_CA=
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password

# Cifrado de campos sensibles
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
# Rotación opcional, orden primario primero. Conservar la clave anterior durante la transición.
FIELD_ENCRYPTION_KEYS=
# Utilizar solamente durante una migración ENC:: y retirarla después.
LEGACY_DJANGO_SECRET_KEY=

# Capa compartida para eventos WebSocket entre procesos ASGI.
# Usar una instancia Redis privada, accesible desde el backend.
PORTAL_CHANNEL_REDIS_URL=replace-with-private-redis-url
# Usar otra base lógica o instancia para throttling y contadores de seguridad.
PORTAL_CACHE_URL=replace-with-private-redis-cache-url

# JWT y sesión
JWT_SIGNING_KEY=replace-with-an-independent-random-key
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE=siminfra_refresh
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_PATH=/api/auth/
PORTAL_IDLE_TIMEOUT_SECONDS=300
PORTAL_PAGE_SIZE=50
PORTAL_MAX_PAGE_SIZE=200
LOGIN_IP_THROTTLE_RATE=10/min
LOGIN_USERNAME_THROTTLE_RATE=5/15min
ADMIN_LOGIN_IP_THROTTLE_RATE=10/min
ADMIN_LOGIN_USERNAME_THROTTLE_RATE=5/15min
REFRESH_THROTTLE_RATE=10/min
SECRET_REVEAL_THROTTLE_RATE=5/min
HEAVY_OPERATION_THROTTLE_RATE=20/hour
API_USER_THROTTLE_RATE=1200/hour
API_ANON_THROTTLE_RATE=60/hour
PORTAL_TRUSTED_PROXY_IPS=127.0.0.1,::1
PORTAL_WS_MAX_CONNECTIONS_PER_IP=20
PORTAL_WS_MAX_CONNECTIONS_PER_USER=5
PORTAL_WS_MESSAGES_PER_SECOND=5
PORTAL_WS_MAX_MESSAGE_BYTES=16384
PORTAL_IMPORT_MAX_FILE_BYTES=26214400
PORTAL_IMPORT_MAX_UNCOMPRESSED_BYTES=104857600
PORTAL_IMPORT_MAX_ZIP_MEMBERS=10000
PORTAL_IMPORT_MAX_ROWS=50000
PORTAL_IMPORT_MAX_COLUMNS=100
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440

# HTTPS. USE_X_FORWARDED_PROTO=True requiere un proxy controlado que reemplace
# X-Forwarded-Proto antes de enviar la solicitud a Django.
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Activar solo tras aprobar formalmente la inclusión pública del dominio y sus subdominios.
SECURE_HSTS_PRELOAD=False

# Dirección HTTPS desde la que se abrirán las fichas QR.
PORTAL_PUBLIC_URL=https://portal.example.cl
