# Desarrollo local
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-stable-local-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=America/Santiago
DJANGO_LOG_LEVEL=INFO

# SQLite local
DATABASE_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# Orígenes del frontend Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
LEGACY_DJANGO_SECRET_KEY=

# Sesión local
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE=siminfra_refresh
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_PATH=/api/auth/
PORTAL_IDLE_TIMEOUT_SECONDS=300
LOGIN_THROTTLE_RATE=5/min
SECRET_REVEAL_THROTTLE_RATE=5/min

# HTTPS se habilita en el perfil productivo
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False

ALLOW_LEGACY_IMPORT=False
