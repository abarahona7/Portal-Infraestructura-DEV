flowchart TB
    LOGIN["Iniciar sesión<br/>Credenciales + CSRF"] --> SESSION["Sesión segura<br/>JWT + sid + refresh HttpOnly"]
    SESSION --> ROLE{"Rol resuelto por el backend"}

    ROLE --> VIEWER["Visualizador<br/>Anexos en modo lectura<br/>Buscar · filtrar · paginar · historial"]
    ROLE --> OPERATOR["Operador Infraestructura<br/>Consultar · crear · editar<br/>Asignar · liberar · exportar"]
    ROLE --> ADMIN["Administrador / superusuario<br/>Acciones operativas + eliminación según módulo<br/>Revelar secretos con reautenticación"]

    VIEWER --> ANEXOS
    OPERATOR --> MODULES{"Seleccionar módulo"}
    ADMIN --> MODULES

    MODULES --> USERS["Usuarios<br/>Área · ficha · IP · equipos · anexo<br/>estado · historial · acta"]
    MODULES --> EQUIPMENT["Equipos<br/>Notebook · celular · tablet · Mac<br/>BAM/Router · periféricos"]
    MODULES --> IPS["Gestión de IP<br/>Segmentos · libres/reservadas<br/>propietario único · historial"]
    MODULES --> ANEXOS["Anexos<br/>Disponibilidad · asignación<br/>liberación · historial"]
    MODULES --> PROFILES["Perfiles genéricos<br/>Área · estado · contraseña<br/>historial"]
    MODULES --> ORG["Departamentos / subáreas<br/>Alta · edición · estado<br/>borrado condicionado"]
    MODULES --> PCS["PCs genéricos<br/>Área · segmento · IP disponible<br/>historial"]
    MODULES --> SERVERS["Servidores<br/>IP disponible de 172.23.1.0/24<br/>historial"]

    USERS --> VALIDATE
    EQUIPMENT --> VALIDATE
    IPS --> VALIDATE
    ANEXOS --> VALIDATE
    PROFILES --> VALIDATE
    ORG --> VALIDATE
    PCS --> VALIDATE
    SERVERS --> VALIDATE

    VALIDATE["Validar rol, campos, duplicados y relaciones"] --> TX["Aplicar cambio en transacción<br/>y sincronizar relaciones"]
    TX --> HISTORY["Registrar historial funcional<br/>y auditoría cuando corresponde"]
    HISTORY --> RESULT["Actualizar la interfaz<br/>y mostrar resultado"]

    USERS -. "LICENCIA: libera IP" .-> IPS
    USERS -. "BAJA: libera IP, equipos y anexo" .-> EQUIPMENT
    USERS -.-> ANEXOS
    PCS -. "asigna/libera" .-> IPS
    SERVERS -. "asigna/libera" .-> IPS

    classDef access fill:#eaf2ff,stroke:#2563eb,color:#10213d,stroke-width:2px;
    classDef operation fill:#e6f7ee,stroke:#138a50,color:#10213d,stroke-width:2px;
    classDef admin fill:#fdecee,stroke:#c9363e,color:#10213d,stroke-width:2px;
    classDef trace fill:#f1ecff,stroke:#6d45c7,color:#10213d,stroke-width:2px;
    classDef validation fill:#fff5df,stroke:#c46a08,color:#10213d,stroke-width:2px;

    class LOGIN,SESSION,VIEWER,USERS,ANEXOS access;
    class OPERATOR,EQUIPMENT,IPS,PCS,SERVERS,TX operation;
    class ADMIN admin;
    class ROLE,MODULES,VALIDATE validation;
    class PROFILES,ORG,HISTORY trace;
    class RESULT access;
